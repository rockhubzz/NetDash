# Credentials for the dashboard's own login page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random string used to sign session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Optional override for the session cookie's Secure flag.
# Default (unset/empty) is automatic: Secure only when the request actually
# arrives over HTTPS (directly or via x-forwarded-proto from your proxy).
# Leave unset for plain-HTTP LAN access AND for HTTPS setups. Only set this
# if auto-detection is wrong for you: 'true' forces Secure (HTTPS-only
# sites where the proxy strips x-forwarded-proto), 'false' forces
# non-Secure (never use over the public internet).
#COOKIE_SECURE=
